# Test environment — uses a separate database to avoid polluting dev data
DATABASE_URL="postgresql://postgres:password@localhost:5432/farmconnect_test?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/farmconnect_test?schema=public"

JWT_SECRET="test-jwt-secret-min-32-chars-long-enough"
JWT_REFRESH_SECRET="test-refresh-secret-min-32-chars-long"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"

RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
RAZORPAY_FUND_ACCOUNT_NUMBER="fa_xxxxxxxxxxxxxx"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

NODE_ENV="test"
PORT="3001"
CORS_ORIGIN="http://localhost:8081"
